{
  "id": "pf2e-tokener",
  "title": "Tokener",
  "version": "2.3.3",
  "compatibility": {
    "minimum": "13",
    "verified": "14",
    "maximum": "14"
  },
  "esmodules": [
    "scripts/pf2e-tokener.js"
  ],
  "styles": [
    "styles/pf2e-tokener.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "languages/en.json"
    }
  ],
  "authors": [
    {
      "name": "RoiLeaf",
      "flags": {}
    }
  ],
  "flags": {
    "canUpload": true
  },
  "action": "manageModule",
