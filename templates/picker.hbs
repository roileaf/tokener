<section
  class='pf2e-tokener-panel'
  style='--pf2e-tokener-art-size: {{gridSize.value}}px; --pf2e-tokener-grid-min-size: {{gridSize.gridMin}}px;'
>
  <div class='pf2e-tokener-layout'>
    <aside class='pf2e-tokener-sidebar'>
      <div class='pf2e-tokener-toolbar'>
        <input
          class='pf2e-tokener-search'
          type='search'
          value='{{searchQuery}}'
          placeholder='{{searchPlaceholder}}'
        />

        <div class='{{source.className}}'>
          <button
            class='pf2e-tokener-source-button'
            type='button'
            aria-haspopup='true'
            aria-expanded='{{source.expanded}}'
          >{{source.label}}</button>
        </div>

        <span class='pf2e-tokener-count'>{{count}}</span>
      </div>

      <div class='{{source.menuClassName}}'>
        <input
          class='pf2e-tokener-source-search'
          type='search'
          value='{{source.filterQuery}}'
          placeholder='{{source.searchPlaceholder}}'
        />

        {{#if source.controls}}
          <div class='pf2e-tokener-source-controls'>
            <button type='button' data-source-action='all'>{{source.selectAllLabel}}</button>
            <button type='button' data-source-action='clear'>{{source.clearLabel}}</button>
          </div>
        {{/if}}

        {{#each source.options}}
          <button
            class='{{className}}'
            type='button'
            data-source-id='{{id}}'
            aria-pressed='{{ariaPressed}}'
          >
            <span class='pf2e-tokener-source-check' aria-hidden='true'></span>
            <span
              class='pf2e-tokener-source-title'
              data-tooltip='{{title}}'
              data-tooltip-direction='UP'
            >{{title}}</span>
            <span class='pf2e-tokener-source-option-count'>{{count}}</span>
          </button>
        {{/each}}
      </div>

      <div class='pf2e-tokener-filter-row'>
          <button
            class='{{favorites.className}}'
            type='button'
            data-favorites-filter='toggle'
            aria-pressed='{{favorites.ariaPressed}}'
            data-tooltip='{{favorites.tooltip}}'
            data-tooltip-direction='UP'
          >{{favorites.buttonLabel}}</button>
          <button
            class='pf2e-tokener-rescan-button'
            type='button'
            data-picker-action='rescan-index'
            aria-label='{{rescan.label}}'
            data-tooltip='{{rescan.tooltip}}'
            data-tooltip-direction='UP'
            {{#if rescan.disabled}}disabled{{/if}}
          ><i class='fas fa-rotate{{#if loading}} fa-spin{{/if}}'></i></button>
      </div>

      <div class='pf2e-tokener-grid-size'>
        <label>
          <span>{{gridSize.label}}</span>
          <span data-grid-size-value>{{gridSize.valueLabel}}</span>
        </label>
        <input
          class='pf2e-tokener-grid-size-slider'
          type='range'
          min='{{gridSize.min}}'
          max='{{gridSize.max}}'
          step='{{gridSize.step}}'
          value='{{gridSize.value}}'
          data-grid-size-input
          aria-label='{{gridSize.label}}'
          data-tooltip='{{gridSize.tooltip}}'
          data-tooltip-direction='UP'
        />
      </div>

      <div class='pf2e-tokener-filter-panel pf2e-tokener-tag-filter {{tags.className}}'>
        <div class='pf2e-tokener-filter-title'>
          <h3>{{tags.title}}</h3>
        </div>

        <div class='pf2e-tokener-filter-tools'>
          <input
            class='pf2e-tokener-tag-search'
            type='search'
            value='{{tags.filterQuery}}'
            placeholder='{{tags.searchPlaceholder}}'
          />
        </div>

        {{#if tags.hasActive}}
          <div class='pf2e-tokener-active-tags'>
            {{#each tags.activeIncluded}}
              <button
                class='{{className}}'
                type='button'
                data-tag-id='{{id}}'
                data-tooltip='{{group}}: {{value}}'
                data-tooltip-direction='UP'
              >
                <span>{{prefix}}</span>
                <span>{{label}}</span>
              </button>
            {{/each}}
            {{#each tags.activeExcluded}}
              <button
                class='{{className}}'
                type='button'
                data-tag-exclude-id='{{id}}'
                data-tooltip='{{group}}: {{value}}'
                data-tooltip-direction='UP'
              >
                <span>{{prefix}}</span>
                <span>{{label}}</span>
              </button>
            {{/each}}
            <button
              class='pf2e-tokener-clear-tags'
              type='button'
              data-tag-action='clear'
            >{{tags.clearLabel}}</button>
          </div>
        {{/if}}

        <div class='pf2e-tokener-tag-groups'>
          {{#each tags.groups}}
            <details class='pf2e-tokener-tag-facet {{className}}' {{#if open}}open{{/if}}>
              <summary class='pf2e-tokener-tag-facet-summary'>
                <span>{{label}}</span>
                <span class='pf2e-tokener-tag-count'>{{displayCount}}</span>
              </summary>
            <div class='pf2e-tokener-tag-options'>
              {{#each visibleOptions}}
                <div class='pf2e-tokener-tag-option'>
                  <button
                    class='pf2e-tokener-tag-chip {{includeClassName}}'
                    type='button'
                    data-tag-id='{{id}}'
                    aria-pressed='{{includeAriaPressed}}'
                    data-tooltip='{{includeTooltip}}'
                    data-tooltip-direction='UP'
                  >{{label}}</button>
                  <button
                    class='{{excludeClassName}}'
                    type='button'
                    data-tag-exclude-id='{{id}}'
                    aria-pressed='{{excludeAriaPressed}}'
                    data-tooltip='{{excludeTooltip}}'
                    data-tooltip-direction='UP'
                  >-</button>
                </div>
              {{/each}}
            </div>
            </details>
          {{/each}}
        </div>
      </div>

      {{#if creator.available}}
        <button
          class='pf2e-tokener-create-button'
          type='button'
          data-picker-action='create-token'
          data-tooltip='{{creator.tooltip}}'
          data-tooltip-direction='UP'
        ><i class='fas fa-wand-magic-sparkles'></i> {{creator.label}}</button>
      {{/if}}

      {{#if revert.available}}
        <div class='pf2e-tokener-revert'>
          <button
            class='pf2e-tokener-revert-button'
            type='button'
            data-revert-action='last'
            data-tooltip='{{revert.tooltip}}'
            data-tooltip-direction='UP'
          >{{revert.buttonLabel}}</button>
          <div class='pf2e-tokener-revert-detail'>{{revert.detail}}</div>
        </div>
      {{/if}}
    </aside>

    <div class='pf2e-tokener-content'>
      {{#if hasResults}}
        {{#each sections}}
          <section class='pf2e-tokener-section'>
            <h4>{{title}}</h4>
            <div class='pf2e-tokener-grid'>
              {{#each candidates}}
                <article class='{{className}}' tabindex='{{tabIndex}}' data-candidate-id='{{viewId}}'>
                  <button
                    class='{{favoriteClassName}}'
                    type='button'
                    data-favorite-candidate-id='{{viewId}}'
                    aria-pressed='{{favoriteAriaPressed}}'
                    data-tooltip='{{favoriteTooltip}}'
                    data-tooltip-direction='UP'
                  >
                    <i class='{{favoriteIconClass}}' aria-hidden='true'></i>
                  </button>
                  {{#if imageTagsEditable}}
                    <button
                      class='pf2e-tokener-custom-image-tags-button'
                      type='button'
                      data-custom-image-tags-candidate-id='{{viewId}}'
                      data-tooltip='{{imageTagsTooltip}}'
                      data-tooltip-direction='UP'
                    >
                      <i class='fas fa-tags' aria-hidden='true'></i>
                    </button>
                  {{/if}}
                  {{#if previewSrc}}
                    <img
                      loading='lazy'
                      src='{{previewSrc}}'
                      data-preview-src='{{previewSrc}}'
                      alt=''
                    />
                  {{/if}}
                  <div class='pf2e-tokener-badge'>{{currentLabel}}</div>
                  <div
                    class='pf2e-tokener-label'
                    data-tooltip='{{cardTooltip}}'
                    data-tooltip-direction='UP'
                  >{{label}}</div>

                  {{#if hasMatchedTags}}
                    <div class='pf2e-tokener-tags'>
                      {{#each matchedTags}}
                        <span
                          class='pf2e-tokener-tag'
                          data-tooltip='{{group}}: {{value}}'
                          data-tooltip-direction='UP'
                        >{{value}}</span>
                      {{/each}}
                    </div>
                  {{/if}}

                  {{#if hasActions}}
                    <div class='pf2e-tokener-actions'>
                      {{#if hasScaleControls}}
                        {{#each scaleControls}}
                          <div class='pf2e-tokener-scale-control' data-scale-control='{{target}}'>
                            <label>{{label}}</label>
                            <span
                              class='pf2e-tokener-scale-value'
                              data-scale-value='{{target}}'
                            >{{valueLabel}}</span>
                            <button
                              class='pf2e-tokener-scale-reset'
                              type='button'
                              data-scale-reset='{{target}}'
                              aria-label='{{resetLabel}}'
                            >
                              <i class='fas fa-undo' aria-hidden='true'></i>
                            </button>
                            <input
                              class='pf2e-tokener-scale-slider'
                              type='range'
                              min='{{min}}'
                              max='{{max}}'
                              step='{{step}}'
                              value='{{value}}'
                              data-scale-default='{{value}}'
                              data-scale-target='{{target}}'
                              aria-label='{{tooltip}}'
                            />
                          </div>
                        {{/each}}
                      {{/if}}
                      {{#each actions}}
                        <button
                          type='button'
                          data-apply-action='{{action}}'
                          data-tooltip='{{tooltip}}'
                          data-tooltip-direction='UP'
                        >{{label}}</button>
                      {{/each}}
                    </div>
                  {{/if}}
                </article>
              {{/each}}
            </div>
          </section>
        {{/each}}
        {{#if paging.hasMore}}
          <button
            class='pf2e-tokener-show-more'
            type='button'
            data-results-action='more'
          >{{paging.showMoreLabel}}</button>
        {{/if}}
      {{else}}
        <div class='pf2e-tokener-state{{#if loading}} is-loading{{/if}}'>{{#if loading}}<i class='fas fa-spinner fa-spin'></i> {{/if}}{{emptyMessage}}</div>
      {{/if}}
    </div>
  </div>
</section>
